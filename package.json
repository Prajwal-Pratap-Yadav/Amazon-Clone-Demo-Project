{
  "name": "everyday-storefront",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "lighthouse": "13.5.0",
    "chrome-launcher": "1.2.1",
    "vitest": "5.0.3",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "prettier": "3.9.9",
    "@types/node": "24.10.1"
  },
  "version": "0.1.0",
  "description": "An educational storefront study with reproducible browser quality measurements",
  "license": "MIT",
  "author": {
    "name": "Prajwal Pratap Yadav",
    "email": "prajwalpratapyadav5@gmail.com"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=reports/local/unit.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vite": "8.3.2"
  }
}
